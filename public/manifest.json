{
  "manifest_version": 3,
  "name": "SubDictate",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "public/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}